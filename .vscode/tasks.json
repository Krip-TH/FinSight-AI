{
  "version": "2.0.0",
  "tasks": [
    {"label": "Dev: backend", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Dev: frontend", "type": "shell", "command": "npm", "args": ["--prefix", "frontend", "run", "dev"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Test: backend", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "backend", "-q"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Build: frontend", "type": "shell", "command": "npm", "args": ["--prefix", "frontend", "run", "build"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ]
}
